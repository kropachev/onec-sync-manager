КонецФункции

Функция ЗначениеИзСтрокиДляОдногоТипаССпособом(ОдинТип, Стр, СпособСопоставления)
	
	Способ = СпособСопоставленияОтбораНормализовать(СпособСопоставления);
	
	Если ОдинТип = Тип("Строка") Тогда
		Возврат Стр;
	ИначеЕсли ОдинТип = Тип("Число") Тогда
		Попытка
			Возврат Число(Стр);
		Исключение
			Возврат 0;
		КонецПопытки;
	ИначеЕсли ОдинТип = Тип("Булево") Тогда
		НС = ВРег(Стр);
		Если НС = "ИСТИНА" Или НС = "TRUE" Или НС = "ДА" Или НС = "1" Тогда
			Возврат Истина;
		ИначеЕсли НС = "ЛОЖЬ" Или НС = "FALSE" Или НС = "НЕТ" Или НС = "0" Тогда
			Возврат Ложь;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	ИначеЕсли ОдинТип = Тип("Дата") Тогда
		Попытка
			Возврат XMLЗначение(Тип("Дата"), Стр);
		Исключение
			Возврат '00010101';
		КонецПопытки;
	ИначеЕсли ОдинТип = Тип("УникальныйИдентификатор") Тогда
		Попытка
			Возврат Новый УникальныйИдентификатор(Стр);
		Исключение
			Возврат Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
		КонецПопытки;
	ИначеЕсли ЭтоСсылочныйТипМетаданных(ОдинТип) Тогда
		Мета = Метаданные.НайтиПоТипу(ОдинТип);
		Если Мета = Неопределено Тогда
			Возврат Стр;
		КонецЕсли;
		ПИ = Мета.ПолноеИмя();
		
		Если СтрНачинаетсяС(ПИ, "Перечисление.") Тогда
			Для Каждого МетаЗнач Из Мета.ЗначенияПеречисления Цикл
				Если ВРег(МетаЗнач.Имя) = ВРег(Стр) Тогда
					Возврат Перечисления[Мета.Имя][МетаЗнач.Имя];
				КонецЕсли;
			КонецЦикла;
			Возврат Неопределено;
		КонецЕсли;
		
		Если СтрНачинаетсяС(ПИ, "Справочник.") Тогда
			Возврат СправочникСсылкаИзСтрокиПоСпособу(Мета.Имя, Стр, Способ);
		КонецЕсли;
		
		Если СтрНачинаетсяС(ПИ, "Документ.") Тогда
			Возврат ДокументСсылкаИзСтрокиПоСпособу(Мета.Имя, Стр, Способ);
		КонецЕсли;
		
		Если СтрНачинаетсяС(ПИ, "ПланВидовХарактеристик.") Тогда
			Возврат ПланВидовХарактеристикСсылкаИзСтрокиПоСпособу(Мета.Имя, Стр, Способ);
		КонецЕсли;
		
		Если СтрНачинаетсяС(ПИ, "ПланСчетов.") Тогда
			Возврат ПланСчетовСсылкаИзСтрокиПоСпособу(Мета.Имя, Стр, Способ);
		КонецЕсли;
		
		Если Способ = Перечисления.МС_СпособСопоставленияПараметраОтбора.Идентификатор
			Или Способ = Перечисления.МС_СпособСопоставленияПараметраОтбора.Авто Тогда
			Попытка
				УИ = Новый УникальныйИдентификатор(Стр);
				Ссылка = СсылкаПоТипуИУникальномуИдентификатору(ОдинТип, УИ);
				Если Ссылка <> Неопределено Тогда
					Возврат Ссылка;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	Возврат Стр;
	
КонецФункции

Функция СтрокаПохожаНаУникальныйИдентификатор(Стр)
	
	Если СтрДлина(Стр) < 36 Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		УИ = Новый УникальныйИдентификатор(Стр);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Функция ПреобразоватьСтрокуПараметраПоТипуИзСтрокиНастроек(Знач СтрокаЗначения, ТипПараметраСтрока)
	
	Если Не ЗначениеЗаполнено(СтрокаЗначения) Тогда
		Возврат "";
	КонецЕсли;
	
	ТипС = ?(ЗначениеЗаполнено(ТипПараметраСтрока), ВРег(СокрЛП(Строка(ТипПараметраСтрока))), "");
	
	Если ТипС = "ЧИСЛО" Или ТипС = "NUMBER" Тогда
		Попытка
			Возврат Число(СтрокаЗначения);
		Исключение
			Возврат 0;
		КонецПопытки;
	ИначеЕсли ТипС = "БУЛЕВО" Или ТипС = "BOOLEAN" Тогда
		НС = ВРег(СокрЛП(Строка(СтрокаЗначения)));
		Возврат НС = "ИСТИНА" Или НС = "TRUE" Или НС = "ДА" Или НС = "1";
	ИначеЕсли ТипС = "ДАТА" Или ТипС = "DATE" Тогда
		Попытка
			Возврат XMLЗначение(Тип("Дата"), СтрокаЗначения);
		Исключение
			Возврат СтрокаЗначения;
		КонецПопытки;
	Иначе
		Возврат СтрокаЗначения;
	КонецЕсли;
	
КонецФункции

#КонецОбласти
