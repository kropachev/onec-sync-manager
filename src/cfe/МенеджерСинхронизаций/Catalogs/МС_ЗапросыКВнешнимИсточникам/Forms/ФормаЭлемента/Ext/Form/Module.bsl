&НаСервереБезКонтекста
Функция ПолучитьТекстНастроек(ОбъектСсылка)
	
	СтруктураНастроек = Новый Структура;
	
    Метаданное = ОбъектСсылка.Метаданные();
	
	Реквизиты = Новый Структура;
	
    Для каждого Реквизит из Метаданное.Реквизиты Цикл
		
		Реквизиты.Вставить(Реквизит.Имя, ОбъектСсылка[Реквизит.Имя]);
		
	КонецЦикла;
	
	СтруктураНастроек.Вставить("Реквизиты", Реквизиты);
	
	ТабличныеЧасти = Новый Структура;
	
	Для каждого ТЧ из Метаданное.ТабличныеЧасти Цикл
		
		Если ОбъектСсылка[ТЧ.Имя].Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ТабличнаяЧасть = Новый Массив;
		
		Для Индекс = 0 по ОбъектСсылка[ТЧ.Имя].Количество()-1 Цикл
			СтрокаТЧ = Новый Структура;
			
			Для каждого РеквизитТЧ Из ТЧ.Реквизиты Цикл
				ОбъектСсылкаСТрокаТЧ = ОбъектСсылка[ТЧ.Имя][Индекс];
				СтрокаТЧ.Вставить(РеквизитТЧ.Имя, ОбъектСсылкаСТрокаТЧ[РеквизитТЧ.Имя]);
			КонецЦикла;
			ТабличнаяЧасть.Добавить(СтрокаТЧ);
		КонецЦикла;
		
		ТабличныеЧасти.Вставить(ТЧ.Имя, ТабличнаяЧасть);
		
	КонецЦикла;        
	
	СтруктураНастроек.Вставить("ТабличныеЧасти", ТабличныеЧасти);
	
	ТекстНастроек = ОбщегоНазначения.ЗначениеВСтрокуXML(СтруктураНастроек);
	
	Возврат ТекстНастроек;
	
КонецФункции

&НаКлиенте
Процедура СохранитьНастройкиВФайл(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Фильтр = "Файл xml|*.xml";
	Диалог.Заголовок = "Выбор файла xml";
	ОповещениеЗавершения = Новый ОписаниеОповещения("ВыборФайлаСохранениеЗавершение", ЭтотОбъект);
	Диалог.Показать(ОповещениеЗавершения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаСохранениеЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено Тогда
		
		ПутьКФайлу = ВыбранныеФайлы[0];
		
		ТекстНастроек = ПолучитьТекстНастроек(Объект.Ссылка);
		
		Файл = Новый ЗаписьТекста(ПутьКФайлу);
		Файл.ЗаписатьСтроку(ТекстНастроек);
		Файл.Закрыть();
		
		Сообщить("Настройки сохранены в файл.");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНастройкиИзФайла(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = "Файл xml|*.xml";
	Диалог.Заголовок = "Выбор файла xml";
	ОповещениеЗавершения = Новый ОписаниеОповещения("ВыборФайлаЧтениеЗавершение", ЭтотОбъект);
	Диалог.Показать(ОповещениеЗавершения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаЧтениеЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено Тогда
		
		ПутьКФайлу = ВыбранныеФайлы[0];
		
		Файл = Новый ЧтениеТекста(ПутьКФайлу);
		ТекстНастроек = Файл.Прочитать();
		Файл.Закрыть();
		
		СтруктураНастроек = ПолучитьНастройкиИзТекста(ТекстНастроек);
		
		ЗаполнитьЗначенияСвойств(Объект, СтруктураНастроек.Реквизиты);
		
		Для каждого ТабличнаяЧасть Из СтруктураНастроек.ТабличныеЧасти Цикл
			
			Объект[ТабличнаяЧасть.Ключ].Очистить();
			
			Для каждого СтрокаТЧНастроек Из ТабличнаяЧасть.Значение Цикл
				
				НоваяСтрокаТЧ = Объект[ТабличнаяЧасть.Ключ].Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧ, СтрокаТЧНастроек);
				
			КонецЦикла; 
			
		КонецЦикла; 

	КонецЕсли;
	
	НастроитьВидимостьЭлементовКлиент();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНастройкиИзТекста(ТекстНастроек)
	
	СтруктураНастроек = ОбщегоНазначения.ЗначениеИзСтрокиXML(ТекстНастроек);
	
	Возврат СтруктураНастроек;
	
КонецФункции

&НаСервере
Процедура ПолучитьПараметрыИзПроцедурыЗагрузкиНаСервере()
	
	НастройкиСинхронизации = Неопределено;
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ТолькоДляЗаполненияЗначенийПараметров", Истина);
	РезультатЗапросаКИсточнику = Неопределено;
	РезультатЗагрузки = Неопределено;
	
	Если ЗначениеЗаполнено(Объект.ПроцедураПодготовкиДанных) Тогда
		Выполнить(Объект.ПроцедураПодготовкиДанных + "(НастройкиСинхронизации, СтруктураПараметров, РезультатЗапросаКИсточнику, РезультатЗагрузки)");
	КонецЕсли; 
	Если ЗначениеЗаполнено(Объект.Процедура) Тогда
		Выполнить(Объект.Процедура + "(НастройкиСинхронизации, СтруктураПараметров, РезультатЗапросаКИсточнику, РезультатЗагрузки)");
	КонецЕсли; 
	
	Если СтруктураПараметров.Свойство("ЗначенияПараметров") Тогда
		Для каждого СтрокаСтруктураЗначенийПараметров Из СтруктураПараметров.ЗначенияПараметров Цикл
			ПараметрыОтбораСтрок = Новый Структура;
			ПараметрыОтбораСтрок.Вставить("ИмяПараметра", СтрокаСтруктураЗначенийПараметров.Ключ);
			НайденныеСтрокиПараметров = ЗначенияПараметров.НайтиСтроки(ПараметрыОтбораСтрок);
			Если НайденныеСтрокиПараметров.Количество() = 0 Тогда
				НоваяСтрокаПараметров = ЗначенияПараметров.Добавить();
				НоваяСтрокаПараметров.ИмяПараметра = СтрокаСтруктураЗначенийПараметров.Ключ;
				НоваяСтрокаПараметров.ЗначениеПараметра = СтрокаСтруктураЗначенийПараметров.Значение;			
			КонецЕсли; 
		КонецЦикла; 
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьПараметрыИзПроцедурыЗагрузки(Команда)
	ПолучитьПараметрыИзПроцедурыЗагрузкиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СпособЗапросаДанныхПриИзменении(Элемент)
	
	Элементы.ГруппаСпособыПолученияДанных.ТекущаяСтраница = Элементы[ИмяСтраницыСпособаЗапросаДанных(Объект.СпособЗапросаДанных)];
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяСтраницыСпособаЗапросаДанных(СпособЗапросаДанных)
	
	// Страница по-умолчанию
	Если СпособЗапросаДанных = "" Тогда
		СпособЗапросаДанных = "ПроизвольныйРезультат";
	КонецЕсли; 
	
	Возврат "Группа" + СпособЗапросаДанных;
	
КонецФункции

