
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// При создании нового элемента
	Если Объект.Ссылка.Пустая()
		Или Объект.СпособЗапросаДанных = "" Тогда
		Объект.СпособЗапросаДанных = "ПроизвольныйРезультат";
	КонецЕсли; 
	
	Элементы.ГруппаСпособыПолученияДанных.ТекущаяСтраница = Элементы[ИмяСтраницыСпособаЗапросаДанных(Объект.СпособЗапросаДанных)];
	
	Если Не Пользователи.РолиДоступны("МС_ОсновнаяРоль") 
		И Не Пользователи.РолиДоступны("ПолныеПрава") Тогда
		
		// Видимость элементов
		Элементы.ФормаСохранитьНастройкиВФайл.Видимость = Ложь;
		Элементы.ФормаЗагрузитьНастройкиИзФайла.Видимость = Ложь;
		Элементы.ТипОбмена.Видимость = Ложь;
		Элементы.ПроцедураПодготовкиДанных.Видимость = Ложь;
		Элементы.Процедура.Видимость = Ложь;
		Элементы.ИнтерактивнаяЗагрузка.Видимость = Ложь;
		Элементы.ГруппаПолучениеДанных.Видимость = Ложь;
		Элементы.ГруппаУведомления.Видимость = Ложь;
		Элементы.ГруппаНастройкиДоступности.Видимость = Ложь;
		Элементы.ДействияПослеСинхронизации.Видимость = Ложь;
		Элементы.ЗначенияПараметровПолучитьПараметрыИзПроцедурыЗагрузки.Видимость = Ложь;
		
		// Возможность редактирования
		Отбор = Новый Структура("ИдентификаторПользователя, Редактирование", 
								ПараметрыСеанса.МС_ИдентификаторТекущегоПользователя, Истина);
		ЭтотОбъект.ТолькоПросмотр = Объект.НастройкиДоступности.НайтиСтроки(Отбор).Количество() = 0;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ТЧЗначенияПараметров) Тогда
		ЗначенияПараметров.Загрузить(ОбщегоНазначения.ЗначениеИзСтрокиXML(Объект.ТЧЗначенияПараметров));
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Объект.ТЧНастройкаСоответствий) Тогда
		НастройкаСоответствий.Загрузить(ОбщегоНазначения.ЗначениеИзСтрокиXML(Объект.ТЧНастройкаСоответствий));
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Объект.ТЧУведомления) Тогда
		Уведомления.Загрузить(ОбщегоНазначения.ЗначениеИзСтрокиXML(Объект.ТЧУведомления));
	КонецЕсли;
	
	НастройкиДоступностиЗаполнитьПользователя();
	
	// Ограничение типа поля Получатель ТЧ Уведомления
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.РолиИсполнителей"));
	МассивТипов.Добавить(Тип("СправочникСсылка.Пользователи"));
	МассивТипов.Добавить(Тип("Строка"));
	КвалификаторыСтроки100 = Новый КвалификаторыСтроки(100);
	ДопустимыеТипы = Новый ОписаниеТипов(МассивТипов, , КвалификаторыСтроки100);
    Элементы.УведомленияПолучатель.ОграничениеТипа = ДопустимыеТипы;
	
	// Ограничение типа поля Пользователь ТЧ НастройкиДоступности
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.Пользователи"));
	ДопустимыеТипы = Новый ОписаниеТипов(МассивТипов);
	Элементы.НастройкиДоступностиПользователь.ОграничениеТипа = ДопустимыеТипы;
	
КонецПроцедуры

